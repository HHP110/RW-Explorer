<Window x:Class="RW_Explorer.Windows.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:RW_Explorer.Controls"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RW Explorer" 
        Height="718" Width="1322" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF1E1E1E">

    <Window.Resources>
        <Storyboard x:Key="TabHoverAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                             From="0.7" To="1" Duration="0:0:0.2"/>
            <ColorAnimation Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)"
                           To="#FF3E3E3E" Duration="0:0:0.2"/>
        </Storyboard>
        <Storyboard x:Key="TabUnhoverAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                             From="1" To="0.7" Duration="0:0:0.2"/>
            <ColorAnimation Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)"
                           To="#FF2E2E2E" Duration="0:0:0.2"/>
        </Storyboard>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" CornerRadius="4" Margin="2,2,2,0" 
                                Background="#FF2E2E2E" Opacity="0.7">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center"
                                            HorizontalAlignment="Center" 
                                            ContentSource="Header" Margin="12,8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF007ACC"/>
                                <Setter TargetName="Border" Property="Opacity" Value="1"/>
                            </Trigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard Storyboard="{StaticResource TabHoverAnimation}"/>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard Storyboard="{StaticResource TabUnhoverAnimation}"/>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FF252526">
            <StackPanel>
                <TextBlock Text="导航菜单" Foreground="White" Margin="10" FontSize="16"/>
                <Separator Background="#FF3E3E3E"/>
                <Button Content="刷新内容" Style="{StaticResource ModernButton}" 
                Click="RefreshButton_Click"/>
                <Button Content="设置" Style="{StaticResource ModernButton}" 
                Click="SettingsButton_Click"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Column="1" Background="#FF1E1E1E" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabPanel">
                    <Setter Property="Background" Value="#FF252526"/>
                </Style>
            </TabControl.Resources>

            <TabItem Header="管理资产文件">
                <controls:AssetsBrowser/>
            </TabItem>

            <TabItem Header="管理线路文件">
                <Frame x:Name="routeManagementFrame" NavigationUIVisibility="Hidden"
           Source="/Controls/RouteManagementPage.xaml"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>