<Window x:Class="RW_Explorer.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RW_Explorer.Windows"
        mc:Ignorable="d"
        Title="设置"
        Width="400" Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <SolidColorBrush x:Key="FluentAccentColor" Color="#FF007ACC"/>
        <SolidColorBrush x:Key="FluentHoverColor" Color="#FF0099FF"/>
        <SolidColorBrush x:Key="FluentPressedColor" Color="#FF0066B3"/>

        <Storyboard x:Key="WindowOpenAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                         From="0.95" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                         From="0.95" To="1" Duration="0:0:0.2"/>
        </Storyboard>

        <Storyboard x:Key="WindowCloseAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1" To="0" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                         From="1" To="0.95" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                         From="1" To="0.95" Duration="0:0:0.15"/>
        </Storyboard>

        <Style x:Key="FluentButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource FluentAccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" 
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform/>
                            </Border.RenderTransform>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource FluentHoverColor}"/>
                                <Setter TargetName="Border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource FluentPressedColor}"/>
                                <Setter TargetName="Border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" 
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <TextBlock Text="✕" FontSize="16" 
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.RenderTransform>
        <ScaleTransform/>
    </Window.RenderTransform>

    <Border CornerRadius="8" BorderBrush="#FF007ACC" BorderThickness="1"
            Background="#FF252526" RenderTransformOrigin="0.5,0.5">
        
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" 
                              Color="#80000000" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FF007ACC" CornerRadius="8,8,0,0"
                    Height="40">
                <Grid>
                    <TextBlock Text="设置" Foreground="White" FontSize="16"
                               VerticalAlignment="Center" Margin="15,0"/>
                    <Button x:Name="btnClose" Style="{StaticResource FluentCloseButton}"
                            HorizontalAlignment="Right" Click="btnClose_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="15">
                    <Border Background="#FF3E3E3E" CornerRadius="4" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="版本号:" Foreground="#FFAAAAAA" 
                           VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtVersion" Text="1.0.0" Foreground="White"
                           Grid.Column="1" Margin="10,0,0,0"
                           VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>
                    <Border Background="#FF3E3E3E" CornerRadius="4" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="软件更新" Foreground="#FFAAAAAA" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="btnCheckUpdate" Content="检查更新" 
                            Style="{StaticResource FluentButton}" Width="100"/>
                                <TextBlock x:Name="txtUpdateStatus" Text="当前版本: 1.0.0" 
                               Foreground="#FFAAAAAA" Margin="15,0,0,0"
                               VerticalAlignment="Center"/>
                            </StackPanel>
                            <ProgressBar x:Name="updateProgress" Height="4" Margin="0,5,0,0" 
                             Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FF3E3E3E" CornerRadius="4" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="关于 RW Explorer" Foreground="#FFAAAAAA"/>
                            <TextBlock Text="模拟列车游戏资源管理工具" Foreground="White"
                           Margin="0,5,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="© 2025 Monologue Group" Foreground="#FFAAAAAA"
                           Margin="0,10,0,0" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Background="#FF252526" CornerRadius="0,0,8,8"
                    Padding="10" BorderBrush="#FF3E3E3E" BorderThickness="0,1,0,0">
                <Button Content="确定" HorizontalAlignment="Right" Width="100"
                        Style="{StaticResource FluentButton}" Click="btnOK_Click"/>
            </Border>
            
            
        </Grid>
    </Border>
</Window>